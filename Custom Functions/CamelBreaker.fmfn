/*
 *  CUSTOM FUNCTION
 *    CamelBreaker ( camelCase )
 *
 *  DESCRIPTION
 *    Breaks camelCase / PascalCase into readable words by inserting spaces
 *    at word boundaries, then title-cases each word (firstName → First Name).
 *
 *    Boundaries:
 *      1. lower → Upper  (firstName → first Name)
 *      2. Upper → UpperLower  (XMLParser → XML Parser)
 *
 *    Exception: a single leading lowercase letter before Upper is kept
 *    attached (iPhone, eBay) and is not title-cased. This also leaves
 *    aValue unsplit — that ambiguity cannot be resolved without a dictionary.
 *
 *  PARAMS
 *    camelCase: Any text string in the camel case format
 *
 *  RETURNS
 *    string
 *
 *  DEPENDENCIES
 *    --None--
 *
 *  CHANGELOG
 *    2021-10-25: Paul McCudden: Created
 *    2025-09-17: Updated to work properly in standard cases
 *    2026-08-07: Rewrite — char scan with acronym + iPhone heuristics
*/

Let (
    [
        ~broken = While (
            [
                ~text = camelCase ;
                ~len = Length ( ~text ) ;
                ~i = 1 ;
                ~out = "" ;
                ~lowerRun = 0 ;
                ~prevIsUpper = False ;
                ~prevIsLower = False
            ] ;

            ~i ≤ ~len ;

            [
                ~ch = Middle ( ~text ; ~i ; 1 ) ;
                ~next = If ( ~i = ~len ; "" ; Middle ( ~text ; ~i + 1 ; 1 ) ) ;

                ~isUpper =
                    Exact ( ~ch ; Upper ( ~ch ) ) and
                    not Exact ( ~ch ; Lower ( ~ch ) ) ;
                ~isLower =
                    Exact ( ~ch ; Lower ( ~ch ) ) and
                    not Exact ( ~ch ; Upper ( ~ch ) ) ;
                ~nextIsLower =
                    Exact ( ~next ; Lower ( ~next ) ) and
                    not Exact ( ~next ; Upper ( ~next ) ) ;

                // lower→Upper, but skip when only one lowercase precedes (iPhone)
                ~camelBreak = ~isUpper and ~prevIsLower and ~lowerRun > 1 ;

                // Upper→UpperLower acronym boundary (XMLParser → XML Parser)
                ~acronymBreak = ~isUpper and ~prevIsUpper and ~nextIsLower ;

                ~out = ~out & If ( ~camelBreak or ~acronymBreak ; " " ) & ~ch ;

                ~lowerRun = If ( ~isLower ; ~lowerRun + 1 ; 0 ) ;
                ~prevIsUpper = ~isUpper ;
                ~prevIsLower = ~isLower ;
                ~i = ~i + 1
            ] ;

            ~out
        )
    ] ;

    // Title-case each word, but leave brand-style words (iPhone, eBay) alone
    While (
        [
            ~words = Substitute ( ~broken ; " " ; ¶ ) ;
            ~n = ValueCount ( ~words ) ;
            ~w = 1 ;
            ~result = ""
        ] ;

        ~w ≤ ~n ;

        [
            ~word = GetValue ( ~words ; ~w ) ;
            ~c1 = Left ( ~word ; 1 ) ;
            ~c2 = Middle ( ~word ; 2 ; 1 ) ;
            ~c1Lower =
                Exact ( ~c1 ; Lower ( ~c1 ) ) and
                not Exact ( ~c1 ; Upper ( ~c1 ) ) ;
            ~c2Upper =
                Exact ( ~c2 ; Upper ( ~c2 ) ) and
                not Exact ( ~c2 ; Lower ( ~c2 ) ) ;
            ~isBrand = Length ( ~word ) ≥ 2 and ~c1Lower and ~c2Upper ;

            ~titled = Case (
                ~isBrand ; ~word ;
                ~c1Lower ; Upper ( ~c1 ) & Middle ( ~word ; 2 ; Length ( ~word ) - 1 ) ;
                ~word
            ) ;

            ~result = ~result & If ( ~w > 1 ; " " ) & ~titled ;
            ~w = ~w + 1
        ] ;

        ~result
    )
)
