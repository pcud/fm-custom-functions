 /*
 *  CUSTOM FUNCTION
 *    ErrorArrayGetLastError ( errorArray )
 *
 *  DESCRIPTION
 *	  Returns the error data for the last error
 *
 *  PARAMS
 *    errorArray: The array of error information generated by ErrorArrayAppend
 *
 *  RETURNS
 *    JSONObject
 *
 *  DEPENDENCIES
 *    ErrorArrayGetLastError
 *
 *  CHANGELOG
 *    2025-07-02: Paul McCudden: Created
 *
*/

Let (
    [
        ~errorArray = JSONSetElement ( "[]"; ""; If ( IsEmpty ( errorArray ); $errorData; errorArray ); JSONArray )
    ];

    JSONGetElement ( ~errorArray; "[:]")

)