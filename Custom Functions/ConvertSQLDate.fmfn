/*
 *  CUSTOM FUNCTION
 *    ConvertSQLDate ( SQLDate )
 *
 *  DESCRIPTION
 *    Converts an SQL formatted date into a naitve FileMaker one
 *
 *  PARAMS
 *    date: An SQL formatted date (YYYY-MM-DD hh:mm:ss.nnnnnnn)
 *
 *  RETURNS
 *    A filemaker naitve date
 *
 *  DEPENDENCIES
 *    --NONE--
 *
 *  CHANGELOG
 *    2021-07-14: Paul McCudden: Created
 *    2026-07-02: Paul McCudden: Updated to handle time and use middle functions for efficiency reasons
*/

Let(
  [
	SQLDate = GetValue ( CullNulls ( SQL.Get1ColumnWhere ( REFERENCE::lastUpdatedDate; ""; "" ) ); 1 );
    ~year  = Middle ( SQLDate;  1; 4 );
    ~month = Middle ( SQLDate;  6; 2 );
    ~day   = Middle ( SQLDate;  9; 2 );
    ~time = Middle ( SQLDate; 12; 999 );
    ~time = If ( IsEmpty ( ~time ); 0; ~time )
  ];


  Timestamp (
    Date ( ~month; ~day; ~year );
    ~time
  )

)