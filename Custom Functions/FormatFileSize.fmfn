/*
 *  CUSTOM FUNCTION
 *    FormatFileSize ( bytes )
 *
 *  DESCRIPTION
 *    Converts a number of bytes into a human-friendly string with an
 *    appropriate unit (B, KB, MB, GB, TB, PB)
 *
 *  PARAMS
 *    bytes: The file size in bytes
 *
 *  RETURNS
 *    Text (e.g. "5GB", "12MB", "128KB", "256B")
 *
 *  DEPENDENCIES
 *    --None--
 *
 *  CHANGELOG
 *    2026-03-24: Paul McCudden: Created
*/

Let (
    [
        ~bytes = GetAsNumber ( bytes );
        ~units = "B¶KB¶MB¶GB¶TB¶PB";

        // Determine the appropriate unit index (1-based) by dividing by 1024 repeatedly
        ~index = Case (
            ~bytes >= 1024 ^ 5 ; 6 ;  // PB
            ~bytes >= 1024 ^ 4 ; 5 ;  // TB
            ~bytes >= 1024 ^ 3 ; 4 ;  // GB
            ~bytes >= 1024 ^ 2 ; 3 ;  // MB
            ~bytes >= 1024 ^ 1 ; 2 ;  // KB
            1                          // B
        );

        ~divisor = 1024 ^ ( ~index - 1 );
        ~value = ~bytes / ~divisor;

        // Round to 2 decimal places, but drop unnecessary trailing zeros
        ~rounded = Round ( ~value ; 2 );
        ~display = Case (
            ~rounded = Int ( ~rounded ) ; Int ( ~rounded ) ;
            ~rounded * 10 = Int ( ~rounded * 10 ) ; Left ( ~rounded ; Position ( ~rounded ; "." ; 1 ; 1 ) + 1 ) ;
            ~rounded
        )
    ];

    ~display & GetValue ( ~units ; ~index )

)
